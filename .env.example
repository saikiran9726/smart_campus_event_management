# Database (PostgreSQL via Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventora?sslmode=disable

# Clerk Authentication & Svix Webhook Verification
CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here
CLERK_SECRET_KEY=sk_test_placeholder_key_here
CLERK_WEBHOOK_SECRET=whsec_placeholder_svix_secret_here

# Cloudflare R2 Object Storage (S3-compatible)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET=eventora-assets
R2_PUBLIC_BASE_URL=https://assets.eventora.campus.edu

# Cloudflare Turnstile Bot Protection
TURNSTILE_SECRET_KEY=0x4AAAAAAplaceholder_secret_key
TURNSTILE_SITE_KEY=0x4AAAAAAplaceholder_site_key

# Resend Email Delivery
RESEND_API_KEY=re_placeholder_resend_api_key
MAIL_FROM=Eventora <events@eventora.campus.edu>

# WhatsApp Notification Integration (meta | baileys | console)
WHATSAPP_PROVIDER=console
META_WA_TOKEN=placeholder_meta_wa_token
META_WA_PHONE_ID=placeholder_meta_wa_phone_id

# Cryptographic Secrets
MAGIC_LINK_SECRET=super_secret_magic_link_hmac_signing_key_32_bytes_min
OD_SEAL_SECRET=super_secret_od_seal_hmac_signing_key_32_bytes_min

# Application URLs
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Payment Gateway Simulation (100% simulated sandbox)
PAYMENT_MODE=sandbox
