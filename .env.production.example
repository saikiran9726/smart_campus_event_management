# ==============================================================================
# EVENTORA PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on your production server.
#
# INVARIANTS ENFORCED BY apps/api/src/env.ts AT STARTUP:
# 1. NODE_ENV must be "production"
# 2. PAYMENT_MODE must be "sandbox" (real-money live payments strictly prohibited)
# 3. TURNSTILE_SECRET_KEY must NOT be a Cloudflare test dummy key (1x0000, 2x0000, 3x0000)
# 4. CLERK_SECRET_KEY must start with "sk_"
# 5. MAGIC_LINK_SECRET and OD_SEAL_SECRET must each be >= 32 characters
# 6. PUBLIC_WEB_URL must use https://
# 7. WHATSAPP_PROVIDER cannot be "baileys" in production
# ==============================================================================

# Node Environment & Server Binding
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# PostgreSQL Service Credentials (Used by postgres container in docker-compose.prod.yml)
POSTGRES_USER=eventora
POSTGRES_PASSWORD=replace_with_strong_production_postgres_password
POSTGRES_DB=eventora

# Database Connection (Targeting the internal postgres service container)
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=postgresql://eventora:replace_with_strong_production_postgres_password@postgres:5432/eventora
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# Public Hostnames & Ingress
PUBLIC_WEB_URL=https://campus.example.com
PUBLIC_API_URL=https://api.campus.example.com

# Cloudflare Tunnel Token (From Cloudflare Zero Trust Dashboard -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Authentication & Identity (Clerk Production Instance)
CLERK_PUBLISHABLE_KEY=pk_live_replace_with_production_clerk_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_production_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_replace_with_clerk_webhook_signing_secret

# Security & Bot Protection (Cloudflare Turnstile Managed Challenge Production Key)
# DO NOT use test keys (1x0000, 2x0000, 3x0000); the production server will fail to start.
TURNSTILE_SECRET_KEY=0x4AAAAAAAReplaceWithProductionCloudflareTurnstileSecretKey

# Cryptographic Token & Verification Signing Secrets (Minimum 32 characters each)
MAGIC_LINK_SECRET=replace_with_minimum_32_char_cryptographic_random_secret_
OD_SEAL_SECRET=replace_with_minimum_32_char_hmac_sha256_seal_secret_string_
# Optional: Set previous seal secret during zero-downtime rotation to preserve existing QR validations
OD_SEAL_SECRET_PREVIOUS=

# Payment Processing (Strictly "sandbox")
PAYMENT_MODE=sandbox

# Object Storage: Cloudflare R2 or S3-Compatible (e.g. Supabase Storage)
# When S3_ENDPOINT is set, R2_ACCOUNT_ID is optional in both dev and production.
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=auto
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_storage_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_storage_secret_access_key
R2_BUCKET=eventora-vault-prod
R2_PUBLIC_BASE_URL=https://vault.campus.example.com

# Transactional Communications (Resend Verified Domain)
RESEND_API_KEY=re_replace_with_production_resend_api_key
COMM_EMAIL_FROM=Eventora <events@campus.example.com>
WHATSAPP_PROVIDER=disabled

# Administrative Role Bootstrap & Domain Policy
INITIAL_ADMIN_EMAILS=dean@campus.example.com,events.lead@campus.example.com
ADMIN_EMAIL_DOMAIN_ALLOWLIST=campus.example.com
