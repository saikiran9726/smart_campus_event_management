{
  "name": "@eventora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:concurrency": "vitest run concurrency",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:seed": "tsx src/db/seed.ts",
    "dev": "tsx watch src/index.ts",
    "tsx": "tsx",
    "generate-samples": "tsx scripts/generate-samples.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@clerk/backend": "^3.26.4",
    "@eventora/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^4.0.2",
    "handlebars": "^4.7.10",
    "ics": "^3.12.1",
    "jose": "^6.2.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "resend": "^6.35.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "svix": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "drizzle-kit": "^0.31.11",
    "jsqr": "^1.4.0",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
