{
  "name": "eventora",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"blue,magenta\" \"pnpm --filter @eventora/api dev\" \"pnpm --filter @eventora/web dev\"",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.5.4"
  }
}
