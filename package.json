{
  "name": "eventora",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build:shared": "pnpm --filter @eventora/shared build",
    "build": "pnpm build:shared && pnpm -r run build",
    "route-audit": "node scripts/route-audit.mjs",
    "reconcile:placeholders": "pnpm --filter @eventora/api exec tsx ../../scripts/reconcile-volunteer-placeholders.ts",
    "dev:users": "pnpm --filter @eventora/api exec tsx ../../scripts/create-dev-users.ts",
    "test": "pnpm build:shared && pnpm -r run test",
    "lint": "pnpm build:shared && pnpm -r run lint",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"blue,magenta\" \"pnpm --filter @eventora/api dev\" \"pnpm --filter @eventora/web dev\"",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "@clerk/clerk-react": "^5.61.11",
      "fflate": ">=0.8.3"
    }
  }
}
